# background
background-opacity = 0.80
background-blur-radius = 20
unfocused-split-opacity = 1


# Window
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-padding-color = background

# Create a window inside the existing Ghostty process, rather than launching
# another macOS application instance. Ghostty will request Accessibility
# permission the first time this global keybind is loaded.
keybind = global:alt+enter=new_window

mouse-hide-while-typing = true
macos-option-as-alt = true
window-decoration = true

# Theme (vendored from github.com/version14/ghostty-theme into themes/)
# light:/dark: lets Ghostty follow the system appearance, the way Zed's
# theme.mode already does -- without it the two diverge when macOS switches.
theme = light:version14-light,dark:version14

# Font
font-size = 17
font-family = GeistMono
