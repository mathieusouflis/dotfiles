[pull]
	rebase = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[push]
	default = current
[rebase]
	autoStash = true
	updateRefs = true
[fetch]
	prune = true
[merge]
	ff = only
[rerere]
	enabled = true
[alias]
	lg = log --oneline --graph --decorate --all
[status]
	branch = true
[safe]
	directory = *
